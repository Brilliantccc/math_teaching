# ===========================================
# 数学题库管理系统 - 环境变量配置
# ===========================================

# 应用配置
SECRET_KEY=your-secret-key-here
DEBUG=true

# 管理员密码
ADMIN_PASSWORD=admin123

# 重置密码码（留空则禁用重置功能）
RESET_CODE=

# ===========================================
# 数据库配置（可选，默认SQLite）
# ===========================================
# DATABASE_URL=sqlite+aiosqlite:///data/question_bank.db

# ===========================================
# 文件上传配置（可选）
# ===========================================
# UPLOAD_DIR=uploads
# MAX_CONTENT_LENGTH=52428800  # 50MB

# ===========================================
# JWT配置（可选）
# ===========================================
# JWT_EXPIRE_HOURS=720  # 30天

# ===========================================
# LLM配置 - AI题目提取与解析生成
# ===========================================

# 模型名称（如 gpt-4, qwen-turbo 等）
LLM_MODEL_ID=

# API密钥
LLM_API_KEY=

# 服务地址（OpenAI兼容接口）
LLM_BASE_URL=

# 超时时间（可选，默认120秒）
LLM_TIMEOUT=120

# ===========================================
# 字体配置（可选，自动检测系统字体）
# ===========================================
# FONT_PATH=/path/to/font.ttf
