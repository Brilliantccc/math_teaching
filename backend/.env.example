# ===========================================
# 数学题库管理系统 - 环境变量配置
# ===========================================

# 应用配置
SECRET_KEY=your-secret-key-here
DEBUG=true

# 管理员密码
ADMIN_PASSWORD=admin123

# 重置密码码（留空则禁用重置功能）
RESET_CODE=

# ===========================================
# LLM配置 - AI题目提取与解析生成
# ===========================================

# 模型名称
LLM_MODEL_ID=

# API密钥
LLM_API_KEY=

# 服务地址
LLM_BASE_URL=

# 超时时间（可选，默认60秒）
LLM_TIMEOUT=60
